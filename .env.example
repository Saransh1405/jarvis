# JARVIS — environment variables (copy to .env and adjust for local dev)
# cp .env.example .env
#
# Docker Compose reads this file from the repo root (infra/docker-compose.yml uses env_file: ../.env).
# Inside Docker, service hostnames are: gateway, api, redis (postgres optional — see infra/docker-compose.yml).
# For local `go run`, load into your shell: set -a && source .env && set +a

# ── Go Gateway ────────────────────────────────────────────────────────────────
# Host/interface the gateway HTTP server binds to
GATEWAY_HOST=0.0.0.0
# Port the gateway listens on (mapped to host in docker-compose)
# If 8080 is taken, pick another port and set VITE_GATEWAY_URL to match (web dev proxy).
GATEWAY_PORT=8080
# Vite dev server proxies /api here — must match GATEWAY_PORT on your machine
VITE_GATEWAY_URL=http://localhost:8080
# Optional: web-stitch dev server port (default 5174)
# VITE_STITCH_PORT=5174
# Optional: pull HTML from Google Stitch (web-stitch npm run stitch:pull)
# STITCH_API_KEY=
# STITCH_PROJECT_ID=13160455557984658905
# Max time to read an entire request (e.g. 15s, 1m)
GATEWAY_READ_TIMEOUT=15s
# Max time to write a response; increase for streaming chat (e.g. 5m)
GATEWAY_WRITE_TIMEOUT=5m
# Base URL of the Python AI service (use http://api:8000 inside Docker)
PYTHON_API_URL=http://localhost:8000
# Secret for signing/validating JWT access tokens (change in production!)
JWT_SECRET=dev-only-change-me
JWT_ISSUER=jarvis
JWT_AUDIENCE=jarvis-api
# Comma-separated API keys for service-to-service auth (optional)
GATEWAY_API_KEYS=
# Comma-separated paths that skip JWT auth (include /api/v1/auth/signup for real accounts)
GATEWAY_PUBLIC_PATHS=/health,/ready,/live,/api/v1/auth/login,/api/v1/auth/signup
# When true (default), gateway exits if POSTGRES_DSN is set but connection fails.
# Set false only for unit tests without a database.
GATEWAY_AUTH_REQUIRES_DB=true
# Dev login stub (disable in production: GATEWAY_DEV_AUTH_ENABLED=false when using DB signup)
GATEWAY_DEV_AUTH_ENABLED=true
GATEWAY_DEV_AUTH_USERNAME=jarvis
GATEWAY_DEV_AUTH_PASSWORD=jarvis
GATEWAY_DEV_AUTH_USER_ID=user-dev-1
GATEWAY_DEV_AUTH_ROLES=user
GATEWAY_DEV_AUTH_PERMISSIONS=chat:read,chat:write
JWT_TTL=24h
# Optional Postgres request audit (structured JSON logs are enough for Phase 1)
GATEWAY_AUDIT_LOG_ENABLED=false
# CORS: comma-separated origins (use explicit origins in production, not *)
GATEWAY_CORS_ORIGINS=*
GATEWAY_CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
GATEWAY_CORS_HEADERS=Authorization,Content-Type,X-Request-ID,X-API-Key
GATEWAY_CORS_MAX_AGE=12h
# Rate limiting (per client IP)
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_RPS=10
GATEWAY_RATE_LIMIT_BURST=20
# Max request body size in bytes (default 1 MiB)
GATEWAY_MAX_BODY_BYTES=1048576
# Trusted reverse proxy IPs for ClientIP() (comma-separated, optional)
GATEWAY_TRUSTED_PROXIES=
# OpenTelemetry tracing
GATEWAY_TRACING_ENABLED=true
GATEWAY_SERVICE_NAME=jarvis-gateway

# ── Python API ────────────────────────────────────────────────────────────────
# Host/interface the FastAPI server binds to
PYTHON_API_HOST=0.0.0.0
# Port the Python API listens on
PYTHON_API_PORT=8000
# LLM — set LLM_PROVIDER to stub | openai | anthropic | gemini
LLM_PROVIDER=stub
# Model for the active provider (use stub-model to pick provider defaults)
LLM_MODEL=stub-model
# Optional OpenAI-compatible base URL (OpenRouter: https://openrouter.ai/api/v1)
LLM_BASE_URL=
# Vendor-specific keys (recommended) or a single fallback:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_API_KEY=
# Max output tokens (Anthropic; OpenAI uses model limits)
LLM_MAX_TOKENS=4096
# Go gateway URL — used by Python policy client (Phase 2)
POLICY_SERVICE_URL=http://localhost:8080

# ── Shared infrastructure ─────────────────────────────────────────────────────
# Neon (recommended): paste the pooled connection string for role neondb_owner (or your role).
# Set BOTH to the same Neon URL (gateway reads POSTGRES_DSN; Python reads DATABASE_URL).
# If POSTGRES_DSN is still localhost but DATABASE_URL is Neon, the gateway will prefer DATABASE_URL.
# Example shape: postgres://neondb_owner:****@ep-....neon.tech/neondb?sslmode=require
DATABASE_URL=
POSTGRES_DSN=
# Local Docker Postgres only (uncomment postgres in infra/docker-compose.yml to use):
# POSTGRES_DSN=postgres://jarvis:jarvis@localhost:5432/jarvis?sslmode=disable
# POSTGRES_USER=jarvis
# POSTGRES_PASSWORD=jarvis
# POSTGRES_DB=jarvis
# Redis connection URL (use redis://redis:6379/0 inside Docker)
REDIS_URL=redis://localhost:6379/0

# ── Observability ─────────────────────────────────────────────────────────────
# Log level: debug, info, warn, error
LOG_LEVEL=info
# Log format: json (production) or text (local debugging)
LOG_FORMAT=json
